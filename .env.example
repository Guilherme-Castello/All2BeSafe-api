# ── Banco de dados ───────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/database

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=5000

# ── Google Cloud Storage (upload de imagens) ─────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json

# ── E-mail (recuperação de senha via Nodemailer / Gmail) ─────────────────────
# EMAIL_PASS precisa ser uma "App Password" do Google (16 caracteres), gerada
# em https://myaccount.google.com/apppasswords com a verificação em duas
# etapas ativada. A senha normal da conta NÃO funciona.
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=
